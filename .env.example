# Copy this file to .env and fill in your own values. Never commit .env.
# Only variables starting with VITE_ reach the browser, and everything here is
# visible to users, so never put secrets in this file.

# URL of the Django backend API
VITE_API_BASE_URL=http://localhost:8000/api

# Google OAuth Client ID (same as the backend's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=
